// THIS CONFIG IS MOSTLY CONFIG FROM VERY COOL GUY atif-1402

{
    "position": "top",
    "margin-top": 8,
    "modules-left": ["clock", "hyprland/language", "mpris"],
    "modules-center": [ "hyprland/workspaces", "custom/notification"],
    "modules-right":[
        "tray",
        "pulseaudio",
        "network",
		"bluetooth",
		"battery",
    ],


    //MODULES//
	"bluetooth": {
		"format": "󰂯  {num_connections}",
		"format-disabled": "󰂲",
		"format-connected": "󰂱 {num_connections}",
		"tooltip-format": "{num_connections} connected\n{device_enumerate}",
		"tooltip-format-enumerate-connected": "{device_alias}",
		"on-click": "omarchy-launch-bluetooth"
	},

	// For laptops
	"battery": {
		"format": "{icon}  {capacity}%",
		"format-charging": "{icon}  {capacity}%",
		"format-plugged": "{icon}  {capacity}%",
		"format-full": "{icon}  100%",
		"format-icons": ["","","","",""],
		"tooltip-format": "⇣ {power:0.1f}W  {capacity}%",
		"tooltip-format-charging": "⇡ {power:0.1f}W  {capacity}%",
		"tooltip-format-plugged": "⇡ {power:0.1f}W  {capacity}%",		"interval": 5,
		"states": {
			"warning": 30,
			"critical": 20
		},
		    "on-click": "omarchy-menu power",
	},
	
    "clock": {
        "format": "{:%I:%M %p}", // AM PM format
        //"format": "{:%H:%M}",// 24H
        "format-alt": "{:%A | %e %B}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "hyprland/language": {
        "format": "  {}",
        "format-en": "US",
        "format-ru": "RU"
    },

    "hyprland/workspaces": {
	    "persistent-workspaces": {"*": [ 1,2,3,4,5,6 ]},
	    "on-click": "activate",
	    "format": "{windows}",
	    "format-window-separator": " ",
	    "window-rewrite-default": "",
	    "window-rewrite": {		
            "class<.*imv*.>": "",
            "class<.*bambustudio*.>": "󰐫",
            "class<.*bitwarden*.>": "",
            "class<.*handbrake*.>": "󰈫",
            "class<.*stremio*.>": "󱖏",
            "title<.*waydroid*.>": "",
            "class<.*grayjay*.>": "󱗆",
	    	"title<.*amazon.*>": "",
	    	"class<firefox|org.mozilla.firefox|librewolf|floorp|mercury-browser|[Cc]achy-browser>": "",
	    	"class<zen>": "󰰷",
	    	"class<waterfox|waterfox-bin>": "",
	    	"class<microsoft-edge>": "",
	    	"class<Chromium|Thorium|[Cc]hrome>": "",
	    	"class<Helium>": "",
	    	"class<brave-browser>": "🦁",
	    	"class<tor-browser>": "",
	    	"class<firefox-developer-edition>": "🦊",
	    	"class<kitty|konsole>": "",
	    	"class<kitty-dropterm>": "",
	    	"class<com.mitchellh.ghostty>": "",
	    	"class<org.wezfurlong.wezterm>": "",
            "class<org.omarchy.terminal>": "󰏖",
	    	"class<[Tt]hunderbird|[Tt]hunderbird-esr>": "",
	    	"class<eu.betterbird.Betterbird>": "",
	    	"title<.*gmail.*>": "󰊫",
	    	"class<[Tt]elegram-desktop|org.telegram.desktop|io.github.tdesktop_x64.TDesktop>": "",
	    	"class<discord|[Ww]ebcord|Vesktop>": "",
	    	"title<.*whatsapp.*>": "",
        "title<.*zapzap.*>": "",
	    	"title<.*messenger.*>": "",
	    	"title<.*facebook.*>": " ",
	    	"title<.*reddit.*>": "",
	    	"title<.*ChatGPT.*>": "󰚩",
			"title<.*Claude.*>": "󰚩",
        "class<.*ChatGPT.*>": "󰚩",
	    	"title<.*deepseek.*>": "󰚩",
	    	"title<.*qwen.*>": "󰚩",
	    	"class<subl>": "󰅳",
	    	"class<slack>": "",
	    	"class<mpv>": "",
	    	"class<celluloid|Zoom>": "",
	    	"class<Cider>": "󰎆 ",
	    	"title<.*Picture-in-Picture.*>": "",
	    	"title<.*youtube.*>": "",
	    	"class<vlc>": "󰕼",
	    	"title<.*cmus.*>": "",
	    	"class<[Ss]potify>": "",
	    	"class<virt-macodeger>": "",
	    	"class<.virt-manager-wrapped>": "",
	    	"class<virtualbox manager>": "💽",
	    	"title<virtualbox>": "💽",
	    	"class<remmina>": "🖥️",
	    	"class<VSCode|code-url-handler|code-oss|codium|codium-url-handler|VSCodium>": "",
        "class<dev.zed.Zed>": "󰵁",
	    	"class<codeblocks>": "󰅩",
	    	"title<.*github.*>": "",
	    	"class<mousepad>": "",
	    	"class<libreoffice-writer>": "",
	    	"class<libreoffice-startcenter>": " 󰏆",
	    	"class<libreoffice-calc>": "",
	    	"title<.*nvim ~.*>": "",
        "class<org.gnome.Nautilus>": "󰣆",
	    	"title<.*vim.*>": "",
	    	"title<.*figma.*>": "",
	    	"title<.*jira.*>": "",
	    	"class<jetbrains-idea>": "",
        "title<*.VSCode.*>": "󰨞",
        "class<.*code.*>": "󰨞",
	    	"class<obs|com.obsproject.Studio>": "",
	    	"class<polkit-gnome-authentication-agent-1>": "󰒃",
	    	"class<nwg-look>": "",
	    	"class<[Pp]avucontrol|org.pulseaudio.pavucontrol>": "󱡫",
	    	"class<steam>": "",
	    	"class<thunar|nemo>": "󰝰",	
        "class<Gparted>":"",
	    	"class<gimp>": "",
	    	"class<emulator>": "📱",
	    	"class<android-studio>": "",
       	"class<org.pipewire.Helvum>": "󰓃",
        "class<localsend>":"",
        "class<PrusaSlicer|UltiMaker-Cura|OrcaSlicer>": "󰹛",
		"class<org.omarchy.yazi>": "󰇥"
	    	}
	    },

    "tray": {
    "icon-size": 21,
    "spacing": 10,
    "icons": {
        "blueman": "bluetooth",
        "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
     }
    },

    "pulseaudio": {
		"format": "{icon}  {volume}",
		"on-click": "omarchy-launch-audio",
		"on-click-right": "omarchy-launch-audio",
		"tooltip-format": "Playing at {volume}%",
		"scroll-step": 5,
		"format-muted": "  {volume}",
		"format-icons": {
			"default": [
				"",
				" ",
				" "
			]
		}
    },

    "network": {
		"format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
		"format": "{icon} {essid}",
		"format-wifi": "{icon}  {essid}",
		"format-ethernet": "󰌘 eth2ernet",
		"format-disconnected": "󰤮",
		"tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
		"tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
		"tooltip-format-disconnected": "Disconnected",
		"interval": 3,
		"spacing": 1,
		"on-click": "omarchy-launch-wifi"
    },

	// If you have swaync
//    "custom/notification": {
//       "tooltip": true,
//       "format": "<span size='16pt'>{icon}</span>",
//       "format-icons": {
//         "notification": "󱅫",
//         "none": "󰂜",
//         "dnd-notification": "󰂠",
//         "dnd-none": "󰪓",
//         "inhibited-notification": "󰂛",
//         "inhibited-none": "󰪑",
//         "dnd-inhibited-notification": "󰂛",
//         "dnd-inhibited-none": "󰪑"
//       },
//       "return-type": "json",
//       "exec-if": "which swaync-client",
//       "exec": "swaync-client -swb",
//       "on-click": "swaync-client -t -sw",
//       "on-click-right": "swaync-client -d -sw",
//       "escape": true
//     },

    "mpris": {
	    "interval": 10,
	    "format": "{player_icon} {dynamic}",
	    "format-paused": "{status_icon}  {artist}",
	    "on-click-middle": "playerctl play-pause",
	    "on-click": "playerctl previous",
	    "on-click-right": "playerctl next",
	    "scroll-step": 5.0,
	    "on-scroll-up": "$HOME/.config/hypr/scripts/volume.sh --inc",
	    "on-scroll-down": "$HOME/.config/hypr/scripts/volume.sh --dec",
	    "smooth-scrolling-threshold": 1,
	    "tooltip": true,
	    "tooltip-format": "{status_icon} {title}\nLeft Click: previous\nMid Click: Pause\nRight Click: Next",
	    "player-icons": {
	    	"chromium": "",
	    	"default": "",
	    	"firefox": "",
	    	"kdeconnect": "",
	    	"mopidy": "",
	    	"mpv": "󰐹",
	    	"spotify": "󰎆",
	    	"vlc": "󰕼",
	    },
	    "status-icons": {
	    	"paused": "",
	    	"playing": "",
	    	"stopped": "",
	    },
	    "dynamic-order": ["artist"],
	    "ignored-players": [ "zen"],
	    "max-length": 25,
    },

	"custom/screenrecording-indicator": {
		"format": "",
        "on-click": "kitty --title=Recorder sh -c '~/.config/hypr/scripts/screenrec.sh'",
        "signal": 8,
		"tooltip": false,
        "return-type": "json"
  	},
}